  def test_marker_name_strips_setter_suffix: () -> untyped

  def test_marker_name_normalizes_leading_double_colon: () -> untyped

  def test_marker_name_handles_single_word_method: () -> untyped

  def test_narrowed_self_type_for_composes_intersection: () -> untyped

  def test_narrowed_self_type_for_nested_class: () -> untyped

  def test_valid_method_name_true_for_normal_methods: () -> untyped

