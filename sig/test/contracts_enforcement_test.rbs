  # `@post.assignments.create`.
  MULTIHOP_RBS: ::String

  MULTIHOP_APP: ::String

  def test_closes_multihop_callback_deref_through_aliased_record_save: () -> untyped

  def test_does_not_close_multihop_without_marker: () -> untyped

  # A local that IS a self path (`_ = user`) roots the deref through it at
