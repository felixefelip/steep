module Steep
  module TypeInference
    module ShortCircuit
      type result = LogicTypeInterpreter::Result

      def self.or_type: (AST::Types::t, result left_truthy, result left_falsy, result right_truthy, result right_falsy) -> AST::Types::t

      def self.and_type: (AST::Types::t, result left_truthy, result left_falsy, result right_truthy, result right_falsy) -> AST::Types::t

      private

      def self.decided_type: (AST::Types::t, Array[result?] exits, result other) -> AST::Types::t
    end
  end
end
